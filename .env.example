# Discord 개발자 포털(https://discord.com/developers/applications)에서 발급받은 봇 토큰
DISCORD_TOKEN=여기에_봇_토큰_입력

# (선택) Typecast API 키 — 설정하면 !목소리목록 에 Typecast 음성이 추가됨 (유료 크레딧 소모)
# 발급: https://studio.typecast.ai/developers
TYPECAST_API_KEY=

# (선택) Google Cloud TTS API 키 — 설정하면 한국어 Neural2 음성이 추가됨
# 월 무료 한도(100만 자)의 95%까지만 사용하고 초과 시 Edge TTS로 자동 전환
# 발급: https://console.cloud.google.com (Cloud Text-to-Speech API 활성화 필요)
GOOGLE_TTS_API_KEY=
